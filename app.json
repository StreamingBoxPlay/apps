<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>StreamingBoxPlay - Aplicativos</title>

    <style>
        :root {
            --bg-color: #0a0b10;
            --card-bg: #131520;
            --card-hover: #1c1f2d;
            --text-color: #ffffff;
            --secondary-text: #9da3b4;
            --accent: #7c3aed;
            --accent-hover: #9333ea;
            --border: rgba(255,255,255,0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg-color);
            color: var(--text-color);
            font-family: Arial, Helvetica, sans-serif;
            min-height: 100vh;
        }

        /* CONTEÚDO PRINCIPAL */
        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px 20px 50px;
        }

        /* TÍTULO */
        .section-title {
            text-align: center;
            font-size: 28px;
            font-weight: 700;
            margin: 20px 0 25px;
        }

        /* GRID DOS CARDS */
        .apps-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        /* CARD */
        .app-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            text-align: center;
            transition: 0.25s ease;
            overflow: hidden;
        }

        .app-card:hover {
            transform: translateY(-4px);
            background: var(--card-hover);
            border-color: rgba(124, 58, 237, 0.5);
        }

        /* ÍCONE */
        .app-icon {
            width: 85px;
            height: 85px;
            object-fit: cover;
            border-radius: 18px;
            margin: 0 auto 12px;
            display: block;
        }

        /* NOME */
        .app-name {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        /* DATA */
        .app-date {
            font-size: 13px;
            color: var(--secondary-text);
            margin-bottom: 8px;
        }

        /* DOWNLOADER */
        .downloader {
            font-size: 13px;
            color: var(--secondary-text);
            margin-bottom: 14px;
        }

        .downloader strong {
            color: #ffffff;
        }

        /* BOTÃO DOWNLOAD */
        .download-btn {
            display: block;
            width: 100%;
            padding: 11px 10px;
            border-radius: 9px;
            background: var(--accent);
            color: #ffffff;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            transition: 0.2s ease;
        }

        .download-btn:hover {
            background: var(--accent-hover);
        }

        /* CARREGAR MAIS */
        .load-more-container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 30px;
        }

        .load-more-btn {
            border: none;
            outline: none;
            cursor: pointer;
            background: var(--accent);
            color: #ffffff;
            padding: 13px 32px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            transition: 0.2s ease;
        }

        .load-more-btn:hover {
            background: var(--accent-hover);
            transform: translateY(-2px);
        }

        .load-more-btn.hidden {
            display: none;
        }

        /* MENSAGEM DE ERRO */
        .error {
            text-align: center;
            color: #ff6b6b;
            margin: 30px 0;
        }

        /* TABLET */
        @media (max-width: 900px) {
            .apps-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        /* CELULAR */
        @media (max-width: 650px) {
            .container {
                padding: 20px 12px 40px;
            }

            .section-title {
                font-size: 24px;
                margin-top: 15px;
            }

            .apps-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .app-card {
                padding: 13px;
                border-radius: 12px;
            }

            .app-icon {
                width: 70px;
                height: 70px;
                border-radius: 15px;
            }

            .app-name {
                font-size: 15px;
            }

            .app-date,
            .downloader {
                font-size: 12px;
            }

            .download-btn {
                font-size: 13px;
                padding: 10px 6px;
            }
        }

        /* CELULARES MUITO PEQUENOS */
        @media (max-width: 380px) {
            .apps-grid {
                gap: 8px;
            }

            .app-card {
                padding: 10px;
            }

            .app-icon {
                width: 60px;
                height: 60px;
            }

            .app-name {
                font-size: 14px;
            }
        }
    </style>
</head>

<body>

    <main class="container">

        <h1 class="section-title">
            Aplicativos disponíveis
        </h1>

        <div id="appsGrid" class="apps-grid"></div>

        <div id="errorMessage" class="error"></div>

        <div class="load-more-container">
            <button
                id="loadMoreBtn"
                class="load-more-btn"
                type="button">
                Carregar mais
            </button>
        </div>

    </main>

    <script>
        const appsGrid = document.getElementById("appsGrid");
        const loadMoreBtn = document.getElementById("loadMoreBtn");
        const errorMessage = document.getElementById("errorMessage");

        let aplicativos = [];
        let quantidadeExibida = 0;

        /*
         * Quantidade inicial:
         * 2 linhas x 4 cards = 8 aplicativos no computador.
         *
         * No celular:
         * 2 linhas x 2 cards = 4 aplicativos.
         */
        const quantidadeDesktop = 8;
        const quantidadeCelular = 4;

        function obterQuantidadeInicial() {
            return window.innerWidth <= 650
                ? quantidadeCelular
                : quantidadeDesktop;
        }

        function criarCard(app) {

            const card = document.createElement("article");

            card.className = "app-card";

            card.innerHTML = `
                <img
                    class="app-icon"
                    src="${app.icone}"
                    alt="${app.nome}"
                    loading="lazy"
                    onerror="this.src='imagem/sem-imagem.png'"
                >

                <div class="app-name">
                    ${app.nome}
                </div>

                <div class="app-date">
                    Atualizado em ${app.data}
                </div>

                <div class="downloader">
                    Downloader:
                    <strong>${app.downloader}</strong>
                </div>

                <a
                    class="download-btn"
                    href="${app.linkDownload}"
                    target="_blank"
                    rel="noopener noreferrer">
                    ⬇ Baixar aplicativo
                </a>
            `;

            return card;
        }

        function renderizarAplicativos() {

            appsGrid.innerHTML = "";

            aplicativos
                .slice(0, quantidadeExibida)
                .forEach(app => {
                    appsGrid.appendChild(criarCard(app));
                });

            atualizarBotao();
        }

        function atualizarBotao() {

            if (quantidadeExibida >= aplicativos.length) {
                loadMoreBtn.classList.add("hidden");
            } else {
                loadMoreBtn.classList.remove("hidden");
            }
        }

        function carregarMais() {

            const quantidadePorClique =
                window.innerWidth <= 650 ? 4 : 8;

            quantidadeExibida += quantidadePorClique;

            renderizarAplicativos();
        }

        loadMoreBtn.addEventListener("click", carregarMais);

        async function carregarApps() {

            try {

                const resposta = await fetch("app.json");

                if (!resposta.ok) {
                    throw new Error("Não foi possível carregar o app.json");
                }

                aplicativos = await resposta.json();

                if (!Array.isArray(aplicativos)) {
                    throw new Error("O app.json precisa conter uma lista de aplicativos.");
                }

                quantidadeExibida = obterQuantidadeInicial();

                renderizarAplicativos();

            } catch (erro) {

                console.error(erro);

                errorMessage.textContent =
                    "Não foi possível carregar os aplicativos.";

                loadMoreBtn.classList.add("hidden");
            }
        }

        carregarApps();
    </script>

</body>
</html>
